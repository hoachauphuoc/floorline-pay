venv/
env/
.venv/

# Environment files
.env
.env.local

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Test coverage
htmlcov/
.coverage

# Demo-video production.
#
# `build/` holds the rendered voiceover and subtitles, which are outputs and do not
# belong in the repository.
#
# The narration source and the tooling that renders it ARE tracked, at
# scripts/build_narration.py, and docs/DEMO_SCRIPT.md documents them. That is a change
# of position from the original rule here, which excluded them on the grounds that "how
# it was assembled is not part of the project". It became untenable once the shooting
# script needed to say which narration line each clip is timed against: a tracked
# document cannot point at an untracked file without giving a reader a dead reference.
#
# The old pattern `tools_build_narration.py` was already dead — the file had moved to
# scripts/ and was being committed regardless, so the rule described an intent the
# repository had stopped honouring.
#
# docs/video-script.txt was the earlier Vietnamese shooting script. It is superseded by
# docs/DEMO_SCRIPT.md and deleted; the entry stays so a stray copy cannot be committed.
docs/video-script.txt
build/

# Scratch probes. Anything named tmp_* is a throwaway and must never be committed.
tmp_*

# IDE / tool-specific
.snowflake/

# Test evidence (local artifacts, regenerated on each run)
tests/evidence/

# Generated reports and coverage output. Regenerated by scripts, not authored.
artifacts/
benchmark_report*.json

# Personal agent tooling (plans, runner, skills, operating rules) and its tests: kept on
# the author's machine, not part of the product.
orchestrator/
.claude/
CLAUDE.md
tests/test_automation_runner_*.py

# Credentials and test accounts that must never be committed: a service-account key, the
# reviewer records that frontend/scripts/make-operator.mjs writes, anything under secrets/.
gcp-key.json
secrets/
password.txt
record.txt
tmp-reviewer-*/
# Working notes in Vietnamese and Japanese, video scripts and raw measurement output: kept on the author's machine.
docs/VIDEO_SCRIPT_PAY_*
docs/guides_vi/
docs/GROUNDING_PLAN.md
docs/screenshots/devpost_pay/
/analyst.json
/reader_holdout_300.json
frontend/AGENTS.md
